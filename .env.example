# Copy to .env and fill in before deploying.
# .env is gitignored — never commit this file with real values.

# Discord webhook for attacker alerts (leave blank to disable)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_ID/YOUR_TOKEN

# Cooldown between alerts per IP per service (seconds, default 3600)
ALERT_COOLDOWN_SECONDS=3600

# Optional: path to MaxMind GeoLite2-City.mmdb for offline geo resolution
# If unset, falls back to ip-api.com (rate-limited to 45 req/min)
GEOIP_DB_PATH=

# Log and DB directories (defaults to ./logs/)
HONEYNET_LOG_DIR=logs
HONEYNET_DB_PATH=logs/honeynet.db

# Dashboard secret key (change this)
DASHBOARD_SECRET=change-me-in-production
