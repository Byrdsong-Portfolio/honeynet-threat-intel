# systemd unit — manages all three honeypot services and the dashboard
# Install: sudo cp deploy/honeynet.service /etc/systemd/system/
#          sudo systemctl daemon-reload
#          sudo systemctl enable honeynet
#          sudo systemctl start honeynet

[Unit]
Description=Honeynet Suite (SSH / HTTP / MySQL honeypots + dashboard)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/honeynet
EnvironmentFile=/opt/honeynet/.env

# Start all four processes. systemd-notify isn't used so Type=simple with
# ExecStartPost chains are cleaner here than Type=forking.
ExecStart=/bin/bash -c "\
  source /opt/honeynet/.venv/bin/activate && \
  python3 ssh_honeypot.py   --port 2222 &  \
  python3 http_honeypot.py  --port 8080 &  \
  python3 mysql_honeypot.py --port 3306 &  \
  python3 dashboard/app.py  --host 127.0.0.1 --port 5000 \
"
Restart=on-failure
RestartSec=5s

# Give honeypots time to flush logs before kill
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
